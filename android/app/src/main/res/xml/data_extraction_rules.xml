<?xml version="1.0" encoding="utf-8"?>
<!-- The collection lives in the WebView's private storage. Cloud backup and device transfer are off:
     Etude Sync (end-to-end encrypted) or an export is how a collection moves between devices. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
