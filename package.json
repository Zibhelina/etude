{
  "name": "@zibhelina/etude",
  "version": "2.0.0",
  "description": "Spaced-repetition practice with programmable card types and AI grading.",
  "keywords": [
    "spaced-repetition",
    "flashcards",
    "fsrs",
    "anki",
    "learning",
    "ai-grading",
    "study",
    "self-hosted"
  ],
  "author": "Joao Araujo",
  "homepage": "https://github.com/Zibhelina/etude#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zibhelina/etude.git"
  },
  "bugs": {
    "url": "https://github.com/Zibhelina/etude/issues"
  },
  "license": "MIT",
  "files": [
    "bin/",
    "src/",
    "runtime/",
    "types/",
    "web/dist/",
    "examples/",
    "docs/",
    "skill/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "bin": {
    "etude": "./bin/etude.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/cli/main.ts serve --dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts && vite build --config web/vite.kit.config.ts",
    "start": "node src/cli/main.ts serve",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "prepack": "npm run build",
    "site": "node site/build.ts",
    "site:serve": "node site/tools/serve.mjs"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@hono/node-server": "^2.1.5",
    "@uiw/react-codemirror": "^4.25.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "hono": "^4.13.13",
    "katex": "^0.19.0",
    "lucide-react": "^1.60.0",
    "marked": "^18.1.1",
    "quickjs-emscripten": "^0.32.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
