{
  "name": "etude",
  "version": "2.0.0-dev",
  "description": "Spaced-repetition practice with programmable card types and AI grading.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "etude": "./bin/etude.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/cli/main.ts serve --dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "node src/cli/main.ts serve",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "hono": "^4.13.13",
    "katex": "^0.19.0",
    "lucide-react": "^1.60.0",
    "marked": "^18.1.1",
    "quickjs-emscripten": "^0.32.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
